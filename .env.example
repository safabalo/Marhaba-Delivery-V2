# ============================================================================
# Marhaba Delivery v2 — Environment Variables (EXAMPLE)
# Copy to .env and fill in. NEVER commit a real .env file.
# In production, load these from a secrets manager (Fly.io secrets,
# Railway variables, Doppler, AWS Secrets Manager, etc.).
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
API_URL=http://localhost:3000
WEB_DASHBOARD_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins (strict allowlist).
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# --- Database (PostgreSQL + PostGIS) ---------------------------------------
# Neon / Supabase managed Postgres. Must have the PostGIS extension enabled.
DATABASE_URL=postgresql://marhaba:marhaba@localhost:5432/marhaba?schema=public

# --- Redis (cache, rate-limit, idempotency, Socket.IO adapter, BullMQ) -----
# Upstash or self-hosted. Use rediss:// for TLS in production.
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_ACCESS_TTL=900          # seconds (15m)
JWT_REFRESH_TTL=1209600     # seconds (14d)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false         # true in production (https only)

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- Mapbox (geocoding / directions / matrix ETA) --------------------------
MAPBOX_ACCESS_TOKEN=pk.replace_me

# --- Notifications ---------------------------------------------------------
# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@marhaba.delivery

# --- Object storage (S3 / Cloudflare R2) — images & proof-of-delivery ------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=marhaba-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# --- Real-time / geo tuning ------------------------------------------------
DRIVER_LOCATION_THROTTLE_MS=5000
ETA_CACHE_TTL_SECONDS=60
